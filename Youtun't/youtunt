#!/usr/bin/env bash
# ==============================================================================
# Youtun't • Custom YouTube Build Engine (official ReVanced bundle)
# Dark Obsidian & Mint Glass Edition
# ==============================================================================

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN_DIR="$DIR/bin"
CONFIG_DIR="$DIR/config"
ASSETS_DIR="$DIR/assets"
INPUT_DIR="$DIR/input"
DIST_DIR="$DIR/dist"
SCRIPTS_DIR="$DIR/scripts"
CACHE_DIR="$DIR/.cache"

BASE_CONFIG="$CONFIG_DIR/youtunt-profile.json"

# Colors (Mint neon & dark terminal aesthetic)
MINT='\033[38;2;0;245;160m'
CYAN='\033[38;2;45;212;191m'
OBSIDIAN='\033[38;2;120;144;156m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

pause() {
    if [ -t 0 ]; then
        read -r -p "${1:-}" _ || true
    fi
}

banner() {
    clear 2>/dev/null || true
    echo -e "${MINT}${BOLD}"
