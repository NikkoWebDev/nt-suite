    echo "  ╚██╗ ██╔╝ ██╔═══██╗ ██║   ██║ ╚══██╔══╝ ██║   ██║ ████╗  ██║ ╚══██╔══╝"
    echo "   ╚████╔╝  ██║   ██║ ██║   ██║    ██║    ██║   ██║ ██╔██╗ ██║    ██║"
    echo "    ╚██╔╝   ██║   ██║ ██║   ██║    ██║    ██║   ██║ ██║╚██╗██║    ██║"
    echo "     ██║    ╚██████╔╝ ╚██████╔╝    ██║    ╚██████╔╝ ██║ ╚████║    ██║"
    echo "     ╚═╝     ╚═════╝   ╚═════╝     ╚═╝     ╚═════╝  ╚═╝  ╚═══╝    ╚═╝"
    echo -e "        ${CYAN}• Official ReVanced bundle • Dark Obsidian & Mint Glass •${NC}"
    echo ""
}

config_path() {
    python3 - "$BASE_CONFIG" "$1" <<'PYEOF'
import json, sys
doc = json.load(open(sys.argv[1], encoding="utf-8"))
value = doc
for part in sys.argv[2].split("."):
    value = value[part]
print(value)
PYEOF
}

ensure_dirs() {
    mkdir -p "$INPUT_DIR" "$DIST_DIR" "$ASSETS_DIR" "$BIN_DIR" "$CACHE_DIR"
}

check_dependencies() {
    local missing=0
    command -v java &>/dev/null || { echo -e "${RED}[ERROR] OpenJDK (java) no encontrado.${NC}"; missing=1; }
    [ -f "$(config_path bundle.cli)" ] || { echo -e "${RED}[ERROR] Falta bin/revanced-cli.jar.${NC}"; missing=1; }
    [ -f "$(config_path bundle.patches)" ] || { echo -e "${RED}[ERROR] Falta el bundle de parches oficial (bin/patches-official.rvp).${NC}"; missing=1; }
    [ $missing -eq 0 ] || exit 1
}

ensure_keystore() {
    local keystore="$DIR/youtunt.keystore"
    local ktool_class="$CACHE_DIR/KsTool.class"
    # ReVanced CLI reads keystores with KeyStore.getInstance("BKS","BC"); keytool
    # PKCS12/JKS files fail with "Wrong version of key store" at signing time.
    [ -f "$ktool_class" ] || javac -cp "$BIN_DIR/revanced-cli.jar" -d "$CACHE_DIR" "$SCRIPTS_DIR/KsTool.java"
    ([ -f "$keystore" ] && java -cp "$CACHE_DIR:$BIN_DIR/revanced-cli.jar" KsTool check "$keystore" youtunt123 youtunt >/dev/null 2>&1) || true
    if [ ! -f "$keystore" ] || ! java -cp "$CACHE_DIR:$BIN_DIR/revanced-cli.jar" KsTool check "$keystore" youtunt123 youtunt >/dev/null 2>&1; then
        [ -f "$keystore" ] && mv "$keystore" "$keystore.broken.bak"
        echo -e "${CYAN}[*] Generando keystore BKS (CN=Youtunt) para Youtun't...${NC}"
        java -cp "$CACHE_DIR:$BIN_DIR/revanced-cli.jar" KsTool create "$keystore" youtunt123 youtunt || {
            echo -e "${RED}[ERROR] No se pudo generar la keystore BKS; aborto antes de firmar con una clave desechable.${NC}"
            exit 1
        }
        echo -e "${GREEN}[✓] Keystore creada exitosamente.${NC}"
    fi
    echo "$keystore"
}

find_input_apk() {
    # Deterministic pick: the exact recommended base first, then the newest
    # glob match. Only YouTube-flavoured APKs qualify so the old arm splits
    # never win silently.
    local recommended
    recommended=$(basename "$(config_path bundle.recommended_base)" 2>/dev/null || true)
    if [ -n "$recommended" ] && [ -f "$INPUT_DIR/$recommended" ]; then
        echo "$INPUT_DIR/$recommended"
        return
    fi
    local glob apk
    glob="$(config_path bundle.base_glob)"
    apk=$(find "$INPUT_DIR" -maxdepth 1 -name "${glob}.apk" -and -not -name "*-temporary-*" 2>/dev/null | sort | tail -n 1)
    if [ -n "$apk" ]; then
        echo -e "${YELLOW}[!] Base recomendada ($(config_path bundle.recommended_base)) no encontrada; usando $(basename "$apk").${NC}" >&2
        echo "$apk"
        return
    fi
    echo ""
}

# Validates every configured patch name + option key against the LIVE patch bundle. An
# unmatched option key is silently dropped by the patcher (option with key ... does not
# exist), so the honest build fails here instead of shipping a half-applied theme.
validate_against_bundle() {
    local patch_file="$1"
    local list_file="$CACHE_DIR/patchlist.txt"
    echo -e "${CYAN}[*] Validando parches y opciones contra $(basename "$patch_file")...${NC}"
    java -jar "$(config_path bundle.cli)" list-patches -p "$patch_file" -b --packages --options > "$list_file.tmp" 2>/dev/null
    mv "$list_file.tmp" "$list_file"

    python3 - "$BASE_CONFIG" "$list_file" "$(config_path bundle.target_package)" <<'PYEOF'
import json, re, sys

doc, list_file, package = json.load(open(sys.argv[1], encoding="utf-8")), sys.argv[2], sys.argv[3]
text = open(list_file, encoding="utf-8", errors="replace").read()

# One block per "Index: N" line; first line is emitted as "INFO: Index: 0".
youtube = {}  # name -> [section bodies]
for section in re.split(r"^(?:INFO: )?Index: \d+$", text, flags=re.M)[1:]:
    m = re.search(r"^Name: (.*)$", section, flags=re.M)
    if not m:
        continue
    if f"Package name: {package}" in section:
        youtube.setdefault(m.group(1).strip(), []).append(section)

errors = []
for entry in doc["patch_options"]:
    sections = youtube.get(entry["patch"], [])
    if not sections:
        errors.append(f"patch '{entry['patch']}' is not declared for {package}")
        continue
    if not any(re.search(rf"^\tName: {re.escape(entry['option'])}$", s, re.M) for s in sections):
        real = sorted({o for s in sections for o in re.findall(r"^\tName: (.*)$", s, re.M)})
        errors.append(f"patch '{entry['patch']}' has no option '{entry['option']}' (real options: {real})")
for name in doc["patch_disable"]:
    if name not in youtube:
        errors.append(f"disable target '{name}' is not declared for {package}")

if errors:
    print("Patch config does not match the live patch bundle:")
    for e in errors:
        print("  - " + e)
    sys.exit(1)
print(f"OK: {sum(1 for _ in doc['patch_options'])} options / {len(doc['patch_disable'])} disables verified.")
PYEOF
}

# Writes the patcher args one per line: $1 = profile JSON (stdout capture goes to the args file).
# CLI v6 grammar makes options/disables PER-PATCH groups: [-O...] (-e name| --ei idx) [(-d name|--di idx)]...
emit_patcher_args() {
    python3 - "$BASE_CONFIG" "$1" "$DIR" <<'PYEOF'
import json, os, sys

base = json.load(open(sys.argv[1], encoding="utf-8"))
profile = json.load(open(sys.argv[2], encoding="utf-8"))
root = sys.argv[3]

def resolve(spec):
    if "value" in spec:
        value = spec["value"]
        return "true" if value is True else ("false" if value is False else str(value))
    section, leaf = spec["from"].split(".", 1)
    value = profile[leaf] if section == "profile" else base[section][leaf]
    if section == "branding":
        return os.path.join(root, value)
    return str(value)

lines = []
by_patch, order = {}, []
for entry in base["patch_options"]:
    patch = entry["patch"]
    if patch not in by_patch:
        by_patch[patch] = []
        order.append(patch)
    by_patch[patch].append(f"{entry['option']}={resolve(entry)}")
# PicoCli binds loose -O tokens to the group instance opened by the last -e,
# so -e MUST come first and every -O for that patch follows it.
for patch in order:
    lines += ["-e", patch]
    for kv in by_patch[patch]:
        lines += ["-O", kv]
for name in base["patch_disable"]:
    lines += ["-e", name, "-d", name]
print("\n".join(lines))
PYEOF
}

build_youtunt() {
    local profile_name=${1:-s21}
    local profile_file="$CONFIG_DIR/profile-$profile_name.json"
    if [ ! -f "$profile_file" ]; then
        echo -e "${RED}[ERROR] No existe config/profile-$profile_name.json (s21 | universal).${NC}"
        exit 1
    fi

    ensure_dirs
    check_dependencies
    local keystore
    keystore=$(ensure_keystore)

    local app_name out_file out_apk
    app_name=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1],encoding='utf-8'))['app_name'])" "$profile_file")
    out_file=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1],encoding='utf-8'))['output'])" "$profile_file")
    out_apk="$DIST_DIR/$out_file"

    echo -e "\n${MINT}${BOLD}═══ Compilando Youtun't [Perfil: ${profile_name^^}] ═══${NC}"
    echo -e "${GREEN}[✓] Nombre de app:${NC} $app_name"

    local input_apk
    input_apk=$(find_input_apk)
    if [ -z "$input_apk" ]; then
        echo -e "${RED}[!] No hay APK base de YouTube en $INPUT_DIR.${NC}"
        echo -e "${YELLOW}Descarga la variante nodpi (recomendada: $(config_path bundle.recommended_base)).${NC}"
        exit 1
    fi
    echo -e "${GREEN}[✓] APK base:${NC} $(basename "$input_apk")"

    if [ ! -f "$ASSETS_DIR/branding/mipmap-xxxhdpi/revanced_adaptive_foreground_custom.png" ]; then
        echo -e "${CYAN}[*] Generando iconos Dark Obsidian & Mint Glass...${NC}"
        python3 "$SCRIPTS_DIR/generate_branding.py" "$ASSETS_DIR/branding"
    fi
    if [ ! -f "$ASSETS_DIR/header/drawable-xxxhdpi/revanced_header_custom_dark.png" ]; then
        echo -e "${RED}[ERROR] Faltan assets/header/drawable-*/revanced_header_custom_*.png (Change header fallará).${NC}"
        exit 1
    fi

    validate_against_bundle "$(config_path bundle.patches)"

    local args_file="$CACHE_DIR/patcher-args-$profile_name.txt"
    emit_patcher_args "$profile_file" > "$args_file"
    local -a patcher_args=()
    mapfile -t patcher_args < "$args_file"

    rm -rf "$DIST_DIR"/*-temporary-files "$DIR"/*-temporary-files 2>/dev/null || true

    echo -e "${CYAN}[*] Parcheando (tema, branding, header, Shorts, GmsCore)...${NC}"
    local arg
    for arg in "${patcher_args[@]}"; do
        echo -e "${OBSIDIAN}      $arg${NC}"
    done
    echo ""

    java -jar "$(config_path bundle.cli)" patch \
        -p "$(config_path bundle.patches)" -b \
        "${patcher_args[@]}" \
        --keystore="$keystore" \
        --keystore-password="youtunt123" \
        --keystore-entry-alias="youtunt" \
        --keystore-entry-password="youtunt123" \
        --purge \
        -o "$out_apk" \
        "$input_apk"

    if [ ! -f "$out_apk" ]; then
        echo -e "${RED}[ERROR] El parcheador no produjo $out_apk.${NC}"
        exit 1
    fi

    echo ""
    echo -e "${GREEN}${BOLD}[✓] ¡Youtun't compilado con éxito!${NC}"
    echo -e "${MINT}APK:${NC} ${BOLD}$out_apk${NC} ($(du -h "$out_apk" | cut -f1))"
    echo ""
    echo -e "${CYAN}AJUSTES EN APP (runtime; el bundle no los trae como opción de build):${NC}"
    echo -e "  • Seekbar menta: Ajustes → ReVanced → Seekbar → Enable custom seekbar color"
    echo -e "    primary #FF00F5A0 · accent #FF2DD4BF (Custom seekbar color / accent color)"
    echo -e "  • Player limpio: Ajustes → ReVanced → Player → Player overlay opacity: 12"
    echo ""
    echo -e "${CYAN}Instalación (cuando haya dispositivo):${NC}"
    echo -e "  ./youtunt install $profile_name"
    echo -e "  — manual: adb install -r \"$(config_path bundle.gmscore)\" && adb install -r \"$out_apk\""
    pause "Presiona ENTER para volver al menú..."
}

install_to_device() {
    ensure_dirs
    local profile=${1:-}
    local target_apk=""
    if [ -n "$profile" ]; then
        local profile_file="$CONFIG_DIR/profile-$profile.json"
        if [ ! -f "$profile_file" ]; then
            echo -e "${RED}[ERROR] No existe config/profile-$profile.json (s21 | universal).${NC}"
            exit 1
        fi
        local out_file
        out_file=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1],encoding='utf-8'))['output'])" "$profile_file")
        if [ -f "$DIST_DIR/$out_file" ]; then
            target_apk="$DIST_DIR/$out_file"
        else
            echo -e "${YELLOW}[!] No esta compilado el perfil $profile; usando el APK mas reciente de dist/.${NC}"
        fi
    fi
    if [ -z "$target_apk" ]; then
        target_apk=$(ls -t "$DIST_DIR"/Youtunt-*.apk 2>/dev/null | head -n 1 || true)
    fi

    if [ ! -f "$target_apk" ] || [ -z "$target_apk" ]; then
        echo -e "${RED}[ERROR] No hay APK de Youtun't en $DIST_DIR. Compila antes: ./youtunt build s21|universal${NC}"
        exit 1
    fi

    echo -e "\n${MINT}${BOLD}═══ Instalando Youtun't ═══${NC}"
    echo -e "APK: ${BOLD}$(basename "$target_apk")${NC}"

    if ! command -v adb &>/dev/null; then
        echo -e "${YELLOW}adb no está en PATH. Comandos manuales:${NC}"
        echo -e "  adb install -r \"$(config_path bundle.gmscore)\""
        echo -e "  adb install -r \"$target_apk\""
        exit 1
    fi

    local devices
    devices=$(adb devices | grep -v "List" | grep "device$" | awk '{print $1}' || true)
    if [ -z "$devices" ]; then
        echo -e "${YELLOW}No hay dispositivo con depuración USB. Cuando lo conectes:${NC}"
        echo -e "  adb install -r \"$(config_path bundle.gmscore)\""
        echo -e "  adb install -r \"$target_apk\""
        exit 1
    fi

    echo -e "${CYAN}Dispositivo: $devices${NC}"
    echo -e "${CYAN}[1/2] Instalando GmsCore (microG)...${NC}"
    adb install -r "$(config_path bundle.gmscore)" || true
    echo -e "${CYAN}[2/2] Instalando $(basename "$target_apk")...${NC}"
    adb install -r "$target_apk"
    echo -e "\n${GREEN}${BOLD}[✓] ¡Youtun't instalado con éxito en tu dispositivo!${NC}"
}

show_status() {
    echo -e "\n${BOLD}--- Estado de Herramientas ---${NC}"
    java -version 2>&1 | head -n 1 | sed 's/^/  /'
    for f in "$(config_path bundle.cli)" "$(config_path bundle.patches)" "$(config_path bundle.gmscore)"; do
        if [ -f "$f" ]; then echo -e "  ${GREEN}✓${NC} $f"; else echo -e "  ${RED}✗${NC} $f"; fi
    done
    echo -e "\n${BOLD}--- Dispositivos ADB ---${NC}"
    adb devices -l 2>/dev/null || true
    echo ""
}

show_mint_guide() {
    echo -e "${MINT}${BOLD}═══ Guía Mint Glass (runtime) ═══${NC}\n"
    echo -e "${CYAN}Seekbar menta (runtime):${NC}"
    echo -e "  Ajustes YouTube → ReVanced → Broad theme section → custom seekbar color:"
    echo -e "  primary ${BOLD}#FF00F5A0${NC} · accent ${BOLD}#FF2DD4BF${NC}"
    echo -e "${CYAN}Opacidad del overlay del player:${NC} ReVanced → Custom player overlay opacity → ${BOLD}12${NC}"
    echo ""
}

menu() {
    while true; do
        banner
        echo -e "${BOLD}Opciones disponibles:${NC}"
        echo -e "  ${MINT}1)${NC} Compilar Youtun't (${BOLD}Perfil S21 FE Tuned${NC})"
        echo -e "  ${MINT}2)${NC} Compilar Youtun't (${BOLD}Perfil Universal${NC})"
        echo -e "  ${MINT}3)${NC} Instalar (GmsCore + Youtun't) vía ADB"
        echo -e "  ${MINT}4)${NC} Optimizar One UI / S21 FE (debloat seguro)"
        echo -e "  ${MINT}5)${NC} Regenerar iconos de marca (Mint Glass)"
        echo -e "  ${MINT}6)${NC} Guía de ajustes Mint Glass (seekbar & overlay)"
        echo -e "  ${MINT}7)${NC} Estado del entorno y dispositivos"
        echo -e "  ${MINT}0)${NC} Salir"
        echo ""
        read -r -p "Selecciona una opción [0-7]: " opt || exit 0
        case $opt in
            1) build_youtunt "s21" ;;
            2) build_youtunt "universal" ;;
            3) install_to_device ;;
            4) bash "$CONFIG_DIR/debloat-oneui-s21.sh" ;;
            5) python3 "$SCRIPTS_DIR/generate_branding.py" "$ASSETS_DIR/branding"; pause "Iconos regenerados. ENTER..." ;;
            6) show_mint_guide; pause "ENTER..." ;;
            7) show_status; pause "ENTER..." ;;
            0) echo -e "\n¡Hasta luego Niko! Que disfrutes de Youtun't.\n"; exit 0 ;;
            *) sleep 1 ;;
        esac
    done
}

# CLI argument dispatcher (non-interactive exit codes: 0 ok, 2 bad usage)
case "${1:-}" in
    build)
        build_youtunt "${2:-s21}"
        ;;
    install)
        install_to_device "${2:-}"
        ;;
    debloat)
        bash "$CONFIG_DIR/debloat-oneui-s21.sh"
        ;;
    branding)
        python3 "$SCRIPTS_DIR/generate_branding.py" "$ASSETS_DIR/branding"
        ;;
    mint)
        show_mint_guide
        ;;
    status)
        show_status
        ;;
    verify)
        ensure_dirs
        validate_against_bundle "$(config_path bundle.patches)"
        ;;
    menu)
        menu
        ;;
    *)
        if [ -t 0 ] || [ "${INTERACTIVE:-0}" = "1" ]; then
            menu
        else
            echo "Uso: ./youtunt build s21|universal | install [profile] | verify | debloat | branding | mint | status | menu"
            exit 2
        fi
        ;;
esac
