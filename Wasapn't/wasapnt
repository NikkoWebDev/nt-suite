set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN_DIR="$DIR/bin"
CONFIG_DIR="$DIR/config"
ASSETS_DIR="$DIR/assets"
INPUT_DIR="$DIR/input"
DIST_DIR="$DIR/dist"
SCRIPTS_DIR="$DIR/scripts"

LSPATCH_JAR="$BIN_DIR/lspatch.jar"
MODULE_APK="$BIN_DIR/WaEnhancerX.apk"
KEYSTORE="$BIN_DIR/wasapnt.keystore"
KEY_PASS="wasapnt123"
KEY_ALIAS="wasapnt"

# Colors (Mint neon, cyan & dark terminal aesthetic)
MINT='\033[38;2;0;245;160m'
CYAN='\033[38;2;88;216;255m'
TEAL='\033[38;2;45;212;191m'
OBSIDIAN='\033[38;2;148;163;184m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

pause_prompt() {
    local msg="${1:-Presiona ENTER para continuar...}"
    if [ -t 0 ]; then
        read -p "$msg"
    fi
}

banner() {
    clear 2>/dev/null || true
    echo -e "${MINT}${BOLD}"
    echo "  ██╗    ██╗ █████╗ ███████╗ █████╗ ██████╗ ███╗   ██╗████████╗"
    echo "  ██║    ██║██╔══██╗██╔════╝██╔══██╗██╔══██╗████╗  ██║╚══██╔══╝"
    echo "  ██║ █╗ ██║███████║███████╗███████║██████╔╝██╔██╗ ██║   ██║   "
    echo "  ██║███╗██║██╔══██║╚════██║██╔══██║██╔═══╝ ██║╚██╗██║   ██║   "
    echo "  ╚███╔███╔╝██║  ██║███████║██║  ██║██║     ██║ ╚████║   ██║   "
    echo "   ╚══╝╚══╝ ╚═╝  ╚═╝╚══════╝╚═╝  ╚═╝╚═╝     ╚═╝  ╚═══╝   ╚═╝   "
    echo -e "       ${CYAN}• Dark Obsidian & Mint Glass • Anti-Meta AI & Privacy •${NC}"
    echo -e "              ${TEAL}Inspirado en nikko.dev • Samsung S21 FE Tuned${NC}"
    echo ""
}

ensure_dirs() {
    mkdir -p "$INPUT_DIR" "$DIST_DIR" "$ASSETS_DIR" "$BIN_DIR" "$CONFIG_DIR" "$SCRIPTS_DIR"
}

check_dependencies() {
    local missing=0
    if ! command -v java &>/dev/null; then
        echo -e "${RED}[ERROR] OpenJDK (java) no encontrado.${NC}"
        missing=1
    fi
    if [ ! -f "$LSPATCH_JAR" ]; then
        echo -e "${RED}[ERROR] Falta bin/lspatch.jar.${NC}"
        missing=1
    fi
    if [ ! -f "$MODULE_APK" ]; then
        echo -e "${RED}[ERROR] Falta bin/WaEnhancerX.apk.${NC}"
        missing=1
    fi
    if [ ! -f "$KEYSTORE" ]; then
        echo -e "${YELLOW}[*] Generando keystore de firma para Wasapn't...${NC}"
        keytool -genkey -v -keystore "$KEYSTORE" -alias "$KEY_ALIAS" -keyalg RSA -keysize 2048 -validity 10000 \
            -storepass "$KEY_PASS" -keypass "$KEY_PASS" \
            -dname "CN=Wasapnt, OU=Dev, O=Nikko, L=City, ST=State, C=ES" &>/dev/null
        echo -e "${GREEN}[✓] Keystore creada exitosamente.${NC}"
    fi
    if [ $missing -eq 1 ]; then
        exit 1
    fi
}

find_input_apk() {
    local apk=""
    # Prefer nodpi or release apks in input/
    apk=$(find "$INPUT_DIR" -maxdepth 1 \( -name "*whatsapp*.apk" -o -name "*com.whatsapp*.apk" \) | head -n 1)
    if [ -z "$apk" ]; then
        apk=$(find "$INPUT_DIR" -maxdepth 1 -name "*.apk" | head -n 1)
    fi
    echo "$apk"
}

build_wasapnt() {
    local profile=${1:-s21}
    ensure_dirs
    check_dependencies

    echo -e "\n${MINT}${BOLD}═══ Compilando Wasapn't [Perfil: ${profile^^}] ═══${NC}"

    local input_apk=$(find_input_apk)
    if [ -z "$input_apk" ]; then
        echo -e "${RED}[!] No se encontró ningún archivo APK base de WhatsApp en:${NC} ${BOLD}$INPUT_DIR${NC}"
        echo -e "${YELLOW}Por favor descarga la versión oficial recomendada de APKMirror:${NC}"
        echo -e "  1. Visita: ${CYAN}https://www.apkmirror.com/apk/whatsapp-inc/whatsapp/${NC}"
        echo -e "  2. Descarga la variante ${BOLD}APK nodpi${NC} (no .apkm ni bundles divididos)"
        echo -e "  3. Guárdala en: ${BOLD}$INPUT_DIR/whatsapp-base.apk${NC}"
        echo ""
        pause_prompt
        return 1
    fi

    echo -e "${GREEN}[✓] APK base detectado:${NC} $(basename "$input_apk")"

    # Regenerate branding icons if needed
    if [ ! -d "$ASSETS_DIR/branding/mipmap-xxxhdpi" ]; then
        echo -e "${CYAN}[*] Generando set de iconos Android Mint Glass...${NC}"
        python3 "$SCRIPTS_DIR/generate_branding.py" "$ASSETS_DIR/branding"
    fi

    local temp_build_dir="$DIST_DIR/build_temp"
    rm -rf "$temp_build_dir" 2>/dev/null || true
    mkdir -p "$temp_build_dir"

    echo -e "${CYAN}[*] Inyectando motor WaEnhancerX sin root con LSPatch...${NC}"
    echo -e "${OBSIDIAN}    - Firma persistente (wasapnt.keystore)${NC}"
    echo -e "${OBSIDIAN}    - Signature Bypass Level 2 (pm + openat - Anti-Ban Safe)${NC}"
    echo -e "${OBSIDIAN}    - Branding Name: Wasapn't${NC}"

    java -jar "$LSPATCH_JAR" "$input_apk" \
        -m "$MODULE_APK" \
        -l 2 \
        --injectdex \
        --name "Wasapn't" \
        -k "$KEYSTORE" "$KEY_PASS" "$KEY_ALIAS" "$KEY_PASS" \
        -f \
        -o "$temp_build_dir"

    local patched_apk=$(find "$temp_build_dir" -maxdepth 1 -name "*.apk" | head -n 1)
    if [ -z "$patched_apk" ] || [ ! -f "$patched_apk" ]; then
        echo -e "${RED}[ERROR] Error en el proceso de inyección de LSPatch.${NC}"
        return 1
    fi

    local final_apk="$DIST_DIR/Wasapnt-${profile^^}.apk"
    mv "$patched_apk" "$final_apk"
    rm -rf "$temp_build_dir"

    echo -e "\n${GREEN}${BOLD}[✓] ¡Compilación exitosa!${NC}"
    echo -e "${MINT}APK Final generado:${NC} ${BOLD}$final_apk${NC}"
    echo -e "${OBSIDIAN}Tamaño: $(du -h "$final_apk" | cut -f1)${NC}"
    echo -e "${YELLOW}Modo offline: tras instalar, desactiva los checks de actualización"
    echo -e "en la gestora WaEnhancerX > Update Settings (ver ./${BOLD}/wasapnt offline${NC}${YELLOW}).${NC}"
    echo ""
    echo -e "${CYAN}Próximos pasos:${NC}"
    echo -e "  1. Corre ${BOLD}./wasapnt install${NC} con tu teléfono conectado por USB con depuración activa."
    echo -e "  2. Abre Wasapn't, dirígete a ${BOLD}Ajustes > WaEnhancerX${NC} para personalizar tu experiencia."
    echo -e "  3. Aplica los códigos de color de ${BOLD}config/wasapnt-theme.json${NC} en el motor de estilos."
    echo ""
    if [ -t 0 ]; then
        pause_prompt
    fi
}

install_wasapnt() {
    ensure_dirs
    local target_apk=$(find "$DIST_DIR" -maxdepth 1 -name "Wasapnt-*.apk" | head -n 1)

    if [ -z "$target_apk" ] || [ ! -f "$target_apk" ]; then
        echo -e "${RED}[!] No hay ningún APK compilado en $DIST_DIR.${NC}"
        echo -e "${YELLOW}Ejecuta primero la opción de compilar.${NC}"
        pause_prompt
        return 1
    fi

    if ! command -v adb &>/dev/null; then
        echo -e "${RED}[ERROR] adb no está instalado en el sistema.${NC}"
        pause_prompt
        return 1
    fi

    echo -e "\n${MINT}${BOLD}═══ Instalando Wasapn't vía ADB ═══${NC}"
    echo -e "${CYAN}[*] Buscando dispositivos conectados...${NC}"
    
    local devices=$(adb devices | grep -v "List" | grep "device$" | awk '{print $1}')
    if [ -z "$devices" ]; then
        echo -e "${RED}[!] No se detectó ningún teléfono conectado con Depuración USB activa.${NC}"
        echo -e "${YELLOW}Verifica que tu Galaxy S21 FE esté conectado y hayas aceptado el mensaje de depuración RSA.${NC}"
        pause_prompt
        return 1
    fi

    echo -e "${GREEN}[✓] Dispositivo detectado:${NC} $devices"
    echo -e "${CYAN}[*] Instalando motor gestor WaEnhancerX...${NC}"
    adb install -r "$MODULE_APK" || true

    echo -e "${CYAN}[*] Instalando $(basename "$target_apk")...${NC}"
    adb install -r "$target_apk"

    echo -e "\n${GREEN}${BOLD}[✓] Wasapn't instalado correctamente en tu teléfono.${NC}"
    pause_prompt
}

