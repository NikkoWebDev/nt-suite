show_status() {
    ensure_dirs
    echo -e "\n${MINT}${BOLD}═══ Wasapn't • Diagnóstico del Entorno ═══${NC}\n"

    # Java OpenJDK
    if command -v java &>/dev/null; then
        local j_ver
        j_ver=$(java -version 2>&1 | head -n 1)
        echo -e "  ${GREEN}[✓]${NC} Java OpenJDK       : ${BOLD}$j_ver${NC}"
    else
        echo -e "  ${RED}[✗]${NC} Java OpenJDK       : No instalado"
    fi

    # LSPatch jar
    if [ -f "$LSPATCH_JAR" ]; then
        local lsp_size
        lsp_size=$(du -h "$LSPATCH_JAR" | cut -f1)
        echo -e "  ${GREEN}[✓]${NC} LSPatch Engine     : bin/lspatch.jar (${lsp_size})"
    else
        echo -e "  ${RED}[✗]${NC} LSPatch Engine     : Falta bin/lspatch.jar"
    fi

    # WaEnhancerX module
    if [ -f "$MODULE_APK" ]; then
        local mod_size
        mod_size=$(du -h "$MODULE_APK" | cut -f1)
        echo -e "  ${GREEN}[✓]${NC} Módulo WaEnhancerX : bin/WaEnhancerX.apk (${mod_size})"
    else
        echo -e "  ${RED}[✗]${NC} Módulo WaEnhancerX : Falta bin/WaEnhancerX.apk"
    fi

    # Keystore
    if [ -f "$KEYSTORE" ]; then
        echo -e "  ${GREEN}[✓]${NC} Firma Keystore     : bin/wasapnt.keystore (alias: ${KEY_ALIAS})"
    else
        echo -e "  ${YELLOW}[!]${NC} Firma Keystore     : No generada aún (se creará al compilar)"
    fi

    # Input APK base
    local apk
    apk=$(find_input_apk)
    if [ -n "$apk" ] && [ -f "$apk" ]; then
        local apk_size
        apk_size=$(du -h "$apk" | cut -f1)
        echo -e "  ${GREEN}[✓]${NC} WhatsApp Base APK  : $(basename "$apk") (${apk_size})"
    else
        echo -e "  ${YELLOW}[!]${NC} WhatsApp Base APK  : No encontrado en input/ (coloca whatsapp-base.apk)"
    fi

    # ADB Tool
    if command -v adb &>/dev/null; then
        local adb_ver
        adb_ver=$(adb version 2>&1 | head -n 1)
        echo -e "  ${GREEN}[✓]${NC} Android ADB        : $adb_ver"
    else
        echo -e "  ${OBSIDIAN}[i]${NC} Android ADB        : No instalado (opcional, necesario solo para ./wasapnt install)"
    fi

    # Dist APK
    local dist_apk
    dist_apk=$(find "$DIST_DIR" -maxdepth 1 -name "Wasapnt-*.apk" 2>/dev/null | head -n 1)
    if [ -n "$dist_apk" ] && [ -f "$dist_apk" ]; then
        local dist_size
        dist_size=$(du -h "$dist_apk" | cut -f1)
        echo -e "  ${GREEN}[✓]${NC} APK Compilado      : $(basename "$dist_apk") (${dist_size})"
    else
        echo -e "  ${OBSIDIAN}[i]${NC} APK Compilado      : Ninguno generado en dist/"
    fi

    echo ""
    pause_prompt
}

show_help() {
    echo -e "${MINT}${BOLD}Wasapn't • Custom WhatsApp Build Engine${NC}"
    echo -e "Uso: ./wasapnt [comando]"
    echo ""
    echo "Comandos disponibles:"
    echo "  status            Verificar dependencias, keystore y módulo WaEnhancerX"
    echo "  build [perfil]    Compilar APK con LSPatch y WaEnhancerX (perfiles: s21, universal)"
    echo "  install           Instalar APK generado y módulo vía ADB"
    echo "  theme             Mostrar paleta y configuración Mint Glass"
    echo "  antiban           Ver directivas y recomendaciones anti-baneo"
    echo "  offline           Guía de uso sin internet y mitigación ANR"
    echo "  help              Mostrar esta ayuda"
    echo ""
}

menu() {
    if [ ! -t 0 ]; then
        show_status
        return 0
    fi
    while true; do
        banner
        echo -e "${MINT}1.${NC} Compilar Wasapn't ${TEAL}(Modo S21 FE Tuned)${NC}"
        echo -e "${MINT}2.${NC} Compilar Wasapn't ${OBSIDIAN}(Modo Universal)${NC}"
        echo -e "${MINT}3.${NC} Instalar en teléfono conectado ${CYAN}(ADB Install)${NC}"
        echo -e "${MINT}4.${NC} Ver paleta y configuración Mint Glass de nikko.dev"
        echo -e "${MINT}5.${NC} Ver directivas Anti-Baneo & Seguridad"
        echo -e "${MINT}6.${NC} Guia Modo Offline sin internet"
        echo -e "${MINT}7.${NC} Diagnóstico y estado del sistema (status)"
        echo -e "${MINT}0.${NC} Salir"
        echo ""
        read -p "Selecciona una opción [0-7]: " choice || break
        case "$choice" in
            1) build_wasapnt s21 ;;
            2) build_wasapnt universal ;;
            3) install_wasapnt ;;
            4) show_theme ;;
            5) show_antiban_guide ;;
            6) OFFLINE_GUIDE ;;
            7) show_status ;;
            0) echo -e "\n${MINT}¡Hasta luego!${NC}\n"; exit 0 ;;
            *) echo -e "${RED}Opción inválida.${NC}"; sleep 1 ;;
        esac
    done
}

# CLI dispatcher
case "${1:-}" in
    status|--status)
        show_status
        ;;
    build|--build)
        build_wasapnt "${2:-s21}"
        ;;
    install|--install)
        install_wasapnt
        ;;
    offline|--offline)
        OFFLINE_GUIDE
        ;;
    theme|--theme)
        show_theme
        ;;
    antiban|--antiban)
        show_antiban_guide
        ;;
    help|--help|-h)
        show_help
        ;;
    "")
        if [ -t 0 ]; then
            menu
        else
            show_status
        fi
        ;;
    *)
        echo -e "${RED}[!] Comando desconocido: $1${NC}\n"
        show_help
        exit 1
        ;;
esac
