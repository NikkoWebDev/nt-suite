menu() {
    while true; do
        banner
        echo -e "${MINT}1.${NC} Compilar Instan't ${TEAL}(Perfil S21 FE Tuned)${NC}"
        echo -e "${MINT}2.${NC} Compilar Instan't ${OBSIDIAN}(Perfil Universal)${NC}"
        echo -e "${MINT}3.${NC} Instalar en teléfono conectado ${CYAN}(ADB Install)${NC}"
        echo -e "${MINT}4.${NC} Ver paleta y configuración Mint Glass"
        echo -e "${MINT}5.${NC} Ver directivas Anti-Baneo & Seguridad"
        echo -e "${MINT}0.${NC} Salir"
        echo ""
        read -r -p "Selecciona una opción [0-5]: " choice || exit 0
        case "$choice" in
            1) build_instant "s21" ;;
            2) build_instant "universal" ;;
            3) install_instant ;;
            4) show_theme ;;
            5) show_antiban_guide ;;
            0) exit 0 ;;
            *) echo -e "${RED}Opción inválida.${NC}"; sleep 1 ;;
        esac
    done
}

# CLI dispatch (non-interactive exit codes: 0 ok, 1 failure)
case "${1:-}" in
    build)
        build_instant "${2:-s21}"
        ;;
    install)
        install_instant "${2:-}"
        ;;
    theme)
        show_theme
        ;;
    antiban)
        show_antiban_guide
        ;;
    menu)
        menu
        ;;
    *)
        if [ -t 0 ] || [ "${INTERACTIVE:-0}" = "1" ]; then
            menu
        else
            echo "Uso: ./instant build s21|universal | install [profile] | theme | antiban | menu"
            exit 2
        fi
        ;;
esac
