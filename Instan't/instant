    banner
    echo -e "${MINT}${BOLD}═══ Sistema de Diseño: Dark Obsidian & Mint Glass ═══${NC}"
    echo -e "${OBSIDIAN}15 slots → engine InstaEclipse (IgThemePalette)${NC}\n"
    python3 - "$CONFIG_DIR" <<'PYEOF'
import json, sys, os
d = json.load(open(os.path.join(sys.argv[1], "palette-dark.json"), encoding="utf-8"))
l = json.load(open(os.path.join(sys.argv[1], "palette-light.json"), encoding="utf-8"))
print("Oscura (paleta personalizada, seed automático):")
for k, h in d["hexReference"].items():
    print(f"  • {k.ljust(14)}: {h}")
print(f"\nClara: preset integrado '{l.get('lightPresetName')}' (id {l['lightPresetId']}) — la paleta custom no es aplicable en modo claro (#251).")
PYEOF
    echo ""
    echo -e "${TEAL}Paletas canónicas: config/palette-dark.json (seed) y config/palette-light.json (referencia).${NC}"
    pause "Presiona ENTER para volver..."
}

